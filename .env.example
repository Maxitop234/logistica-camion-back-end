# =============================================================================
# EcoRuta Temuco · API back-end — variables de entorno
# Copia este archivo a .env y completa los valores. Nunca commitees .env.
# Las variables marcadas "(pendiente XX-NN)" aún no las lee el código; las
# incorpora la tarea indicada en tasks/.
# =============================================================================

APP_NAME="EcoRuta Temuco"
APP_ENV=local
# Se genera con: vendor/bin/sail artisan key:generate
# OJO: cifra el nombre y teléfono de los choferes y el HMAC del RUT. Si se
# cambia, se pierden esos datos; para rotarla usa APP_PREVIOUS_KEYS.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_DEMO_MODE=false
APP_URL=http://localhost

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="EcoRutaTemuco/1.0 (contacto@ecoruta.cl)"
NOMINATIM_TIMEOUT=5

APP_LOCALE=es
# Sin archivos en lang/es los mensajes de validación caen al inglés del framework
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Producción/demo en la nube: LOG_CHANNEL=stderr (Render y AWS recogen stdout/stderr)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos: PostgreSQL (+ PostGIS) en el contenedor "pgsql" de Sail ---
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ecoruta
DB_USERNAME=sail
DB_PASSWORD=password
# Neon/AWS RDS exigen TLS: DB_SSLMODE=require (local: prefer)
DB_SSLMODE=prefer

# Puertos publicados por Sail en el equipo
APP_PORT=80
FORWARD_DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sin worker (plan gratis de Render): sync. Con worker propio (AWS): database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@ecoruta.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Despliegue en la nube (ver docs/DESPLIEGUE_DEMO.md) ---
# Puerto HTTP (Render lo inyecta) y procesos del servidor PHP integrado
PORT=10000
PHP_CLI_SERVER_WORKERS=2
# Orígenes del panel web que pueden llamar a la API, separados por coma
CORS_ALLOWED_ORIGINS=

# --- Autenticación (Sanctum) ---
# (pendiente BE-02) minutos de vida de los tokens Bearer; vacío = no expiran
SANCTUM_EXPIRATION=720

# --- Ruteo con OpenStreetMap (ADR-0005) ---
# (pendiente BE-10) "osrm" usa el motor OSRM; "proximidad" fuerza el modo degradado PostGIS
RUTEO_DRIVER=osrm
# Demo en la nube: https://router.project-osrm.org (servidor público, solo para demostración)
OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT=6
RUTEO_TIMEOUT_SEGUNDOS=20
# Planta de Somos Terranova (origen y destino de las rutas)
PLANTA_LATITUD=-38.7655
PLANTA_LONGITUD=-72.5865

# --- GPS (ADR-0004) ---
# (pendiente BE-07) días que se conserva la traza GPS antes de anonimizarla (Ley 21.719)
GPS_RETENCION_DIAS=90
# (pendiente BE-08) minutos sin ping para marcar un teléfono como "sin señal"
GPS_MINUTOS_SIN_SENAL=2

# --- Puntos de reciclaje y sectores (BE-03, ADR-0013) ---
# Caja de la zona de operación (Temuco con Labranza y Padre Las Casas); fuera de ella → 422
ZONA_LATITUD_MIN=-38.85
ZONA_LATITUD_MAX=-38.62
ZONA_LONGITUD_MIN=-72.85
ZONA_LONGITUD_MAX=-72.45
# Zona horaria en que se interpretan los días de recolección de cada sector
ZONA_HORARIA_OPERACION=America/Santiago

# --- Sensores IoT (ADR-0007, ADR-0012) ---
# Horas que una lectura de sensor mantiene vigente el estado de un punto (ADR-0013)
ESTADO_SENSOR_VIGENCIA_HORAS=24
# (pendiente BE-05) minutos sin lectura para marcar un nodo como "sin reporte"
IOT_MINUTOS_SIN_REPORTE=30
# Sensores (config/iot.php): intervalo por defecto, umbrales de alerta y límites de vinculación.
IOT_INTERVALO_DEFECTO_SEG=3600
IOT_INTERVALOS_SIN_REPORTE=2
IOT_BATERIA_MINIMA_V=3.40
IOT_INVALIDAS_PARA_ALERTA=3
IOT_VINCULACION_INTENTOS_IP=10
IOT_VINCULACION_INTENTOS_HW=20
IOT_PREFIJO_HARDWARE=ECO
# Simulador de sensores (solo con APP_DEMO_MODE=true).
IOT_SIMULADOR_INTERVALO_SEG=1800

# --- Licencias de conducir (ADR-0010) ---
# (pendiente BE-12) disco privado donde se guardan los documentos
LICENCIAS_DISK=local
LICENCIAS_MAX_KB=5120

# --- Cuenta inicial de la empresa (DatabaseSeeder con APP_DEMO_MODE=false) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE="Administración EcoRuta"

# --- Ambiente de demostración (DemoSeeder con APP_DEMO_MODE=true) ---
# Nunca usar credenciales reales de la empresa en el ambiente de demostración.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_CHOFER_PASSWORD=

# --- AWS (staging/producción, BE-16) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Detección de desvíos (traza GPS real contra ruta planificada)
DESVIO_UMBRAL_M=40
DESVIO_LONGITUD_MINIMA_M=100
DESVIO_UMBRAL_REPORTE=3
